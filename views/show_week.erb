   <script src="/calendar_name_editor.js"></script>
  <script>
  document.querySelectorAll(".pdf-btn").forEach(btn => {
    btn.addEventListener("click", async () => {
      const calendarCard = btn.closest(".calendar-card");
      const weekCalendar = calendarCard.querySelector(".week-calendar");
      const filename = (btn.dataset.calendarName || "カレンダー") + ".pdf";
  
      // 各曜日の背景色を取得
      const dayColumns = weekCalendar.querySelectorAll(".day-column");
      const colors = Array.from(dayColumns).map(col => {
        return col.style.background || col.style.backgroundColor || "";
      });
  
      // PDF生成用の表示エリア
      const pdfStage = document.createElement("div");
      pdfStage.style.position = "fixed";
      pdfStage.style.left = "0";
      pdfStage.style.top = "0";
      pdfStage.style.width = "100vw";
      pdfStage.style.height = "100vh";
      pdfStage.style.background = "rgba(255, 255, 255, 0.01)";
      pdfStage.style.zIndex = "999999";
      pdfStage.style.overflow = "visible";
  
      // 実際にPDF化するA4横ページ
      const pdfPage = document.createElement("div");
      pdfPage.style.width = "297mm";
      pdfPage.style.height = "210mm";
      pdfPage.style.background = "white";
      pdfPage.style.padding = "10mm";
      pdfPage.style.boxSizing = "border-box";
      pdfPage.style.overflow = "hidden";
  
      pdfPage.innerHTML = `
        <style>
          .pdf-week-calendar {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            gap: 8px;
            background-color: white;
            width: 100%;
            height: 100%;
            padding: 0;
            margin: 0;
            box-sizing: border-box;
          }
  
          .pdf-week-calendar .day-column {
            border: 1px solid black;
            padding: 5px;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            box-sizing: border-box;
          }
  
          .pdf-week-calendar .day-column:nth-child(1) { background-color: ${colors[0]} !important; }
          .pdf-week-calendar .day-column:nth-child(2) { background-color: ${colors[1]} !important; }
          .pdf-week-calendar .day-column:nth-child(3) { background-color: ${colors[2]} !important; }
          .pdf-week-calendar .day-column:nth-child(4) { background-color: ${colors[3]} !important; }
          .pdf-week-calendar .day-column:nth-child(5) { background-color: ${colors[4]} !important; }
          .pdf-week-calendar .day-column:nth-child(6) { background-color: ${colors[5]} !important; }
          .pdf-week-calendar .day-column:nth-child(7) { background-color: ${colors[6]} !important; }
  
          .pdf-week-calendar .drop-zones {
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            flex: 1;
            overflow: hidden;
          }
  
          .pdf-week-calendar .day-label {
            font-weight: bold;
            text-align: center;
            height: 50px;
            border-bottom: 2px solid black;
            display: flex;
            justify-content: center;
            align-items: center;
            flex-shrink: 0;
          }
  
          .pdf-week-calendar .day-label p {
            font-size: 28px;
            margin: 0;
            font-weight: bold;
          }
  
          .pdf-week-calendar .drop-zone {
            flex: 1;
            min-height: 0;
            border: 1px dashed #ddd;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 4px;
            box-sizing: border-box;
          }
  
          .pdf-week-calendar .drop-zone:last-child {
            margin-bottom: 0;
          }
  
          .pdf-week-calendar .day-image {
            width: 70%;
            max-height: 100%;
            object-fit: contain;
          }
        </style>
  
        <div class="pdf-week-calendar">
          ${weekCalendar.innerHTML}
        </div>
      `;
  
      pdfStage.appendChild(pdfPage);
      document.body.appendChild(pdfStage);
  
      // 画像読み込み待ち
      const images = pdfPage.querySelectorAll("img");
  
      const imagePromises = Array.from(images).map(img => {
        return new Promise(resolve => {
          if (img.complete) {
            resolve();
          } else {
            img.onload = resolve;
            img.onerror = resolve;
          }
        });
      });
  
      await Promise.all(imagePromises);
  
      // レイアウト反映待ち
      await new Promise(resolve => setTimeout(resolve, 500));
  
      const opt = {
        margin: 0,
        filename: filename,
        image: {
          type: "jpeg",
          quality: 0.98
        },
        html2canvas: {
          scale: 2,
          useCORS: true,
          backgroundColor: "#ffffff",
          scrollX: 0,
          scrollY: 0
        },
        jsPDF: {
          unit: "mm",
          format: "a4",
          orientation: "landscape"
        }
      };
  
      await html2pdf()
        .set(opt)
        .from(pdfPage)
        .save();
  
      document.body.removeChild(pdfStage);
    });
  });

// 印刷機能
