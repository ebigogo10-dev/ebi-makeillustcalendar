            </button>
          </div>
          <% if calendar.start_day.nil? && calendar.day.nil? %>
          <p>カレンダーの月:不明 / 作成日:不明</p>
          <% if @user.name.nil? %>
          <p>作成者:<%= @user.mail%></p>
          <% else %>
          <p>作成者:<%= @user.name%></p>
          <% end %>
          <% elsif calendar.start_day.nil?%>
          <p>カレンダーの月:不明 / 作成日:<%= calendar.day %></p>
          <% if @user.name.nil? %>
          <p>作成者:<%= @user.mail%></p>
          <% else %>
          <p>作成者:<%= @user.name%></p>
          <% end %>
          <% elsif calendar.day.nil?%>
          <p>カレンダーの月:<%= calendar.start_day.strftime("%Y年%m月")%> / 作成日:不明</p>
          <% if @user.name.nil? %>
          <p>作成者:<%= @user.mail%></p>
          <% else %>
          <p>作成者:<%= @user.name%></p>
          <% end %>
          <% else %>
          <p>カレンダーの月:<%= calendar.start_day.strftime("%Y年%m月")%> / 作成日:<%= calendar.day %></p>
          <% if @user.name.nil? %>
          <p>作成者:<%= @user.mail%></p>
          <% else %>
          <p>作成者:<%= @user.name%></p>
          <% end %>
          <% end %>

