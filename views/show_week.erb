          <div class="calendar-name-editor" data-update-url="/calendar_name/<%= @user.id %>/<%= calendar.id %>" data-current-name="<%= escaped_calendar_name %>">
            <h3 class="calendar-name-text"><%= escaped_calendar_name %></h3>
            <input type="text" class="calendar-name-input" value="<%= escaped_calendar_name %>" aria-label="カレンダー名" maxlength="255" hidden>
            <button type="button" class="calendar-name-edit-btn" aria-label="カレンダー名を編集" title="カレンダー名を編集">
