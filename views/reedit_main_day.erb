   <script src="/script.js"></script>
    <script>
 function buildDayCalendarJson() {
    const result = {};

    document.querySelectorAll('.time-column').forEach(column => {
      const timeKey = column.dataset.time;
          const preview = column.querySelector(".time-display");
          const timeStyleInput = document.getElementById("timeStyleInput");
          const timeInput = document.getElementById(`timeInput_${timeKey}`);
          const zones = column.querySelectorAll('.drop-zone');
          const images = Array.from(zones).map(zone => {
            const img = zone.querySelector("img.day-image");
            if (!img) return null;
            const url = new URL(img.src, window.location.origin);
            return url.origin === window.location.origin ? url.pathname : url.href;
          });

          result[timeKey] = {
            time: preview?.dataset.timeText || preview?.textContent?.trim() || "",
          timeValue: timeInput?.value || preview?.dataset.timeValue || "",
          style: normalizeTimeStyle(timeStyleInput?.value || preview?.dataset.timeStyle),

            images: images
          };
        });

        return result;
      }
      document.querySelector('.save-button').addEventListener('click', async () => {
      const data = buildDayCalendarJson();
    
      try {
        const res = await fetch("/recalendar_day/<%= @user.id %>/<%= @calendar_id.id %>", {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify(data)
        });
    
        if (!res.ok) {
          console.error('保存失敗', await res.text());
          alert('保存に失敗しました');
          return;
        }
    
        const json = await res.json();
        console.log('保存完了:', json);
        alert('保存できました！');
        if (json.redirect_to) {
        window.location.href = json.redirect_to;
        }
      } catch (e) {
        console.error('通信エラー', e);
        alert('通信エラーが発生しました');
      }
    });
  
 document.addEventListener("DOMContentLoaded", () => {
  const timeStyleInput = document.getElementById("timeStyleInput");
  const timeStyleButtons = document.querySelectorAll("[data-time-style-value]");

  const setTimeStyleValue = (style) => {
    const normalizedStyle = normalizeTimeStyle(style);
    if (timeStyleInput) timeStyleInput.value = normalizedStyle;

    timeStyleButtons.forEach(button => {
      const isActive = button.dataset.timeStyleValue === normalizedStyle;
      button.classList.toggle("active", isActive);
      button.setAttribute("aria-pressed", String(isActive));
    });

    return normalizedStyle;
  };

  const renderAllTimePreviews = () => {
    for (let i = 1; i <= 7; i++) {
      const input = document.getElementById(`timeInput_${i}`);
      const preview = document.getElementById(`timePreview_${i}`);
      renderTimePreview(input, timeStyleInput?.value, preview);
    }
  };

  const savedGlobalStyle = (() => {
    for (let i = 1; i <= 7; i++) {
      const saved = savedDayTimes[String(i)] || {};
      const style = saved.style || inferTimeStyle(saved.time);
      if (style) return normalizeTimeStyle(style);
    }
    return normalizeTimeStyle(timeStyleInput?.value);
  })();

  setTimeStyleValue(savedGlobalStyle);
  initializeHourPickers();
  

  function parseTime(value) {
    const rawValue = String(value || "").trim();
    if (!rawValue) return null;
    const hh = rawValue.includes(":") ? rawValue.split(":")[0] : rawValue;
    const h = Number(hh);
    if (!Number.isInteger(h) || h < 0 || h > 23) return null;
    return { h };
  }

  function formatTime({ h }, style) {
    if (style === "kanji" || style === "clock") return `${h}時`;

    const hiraNums = ["ぜろ","いち","に","さん","よん","ご","ろく","なな","はち","きゅう"];
    const toHira = (n) => {
      if (n < 10) return hiraNums[n];
      if (n === 10) return "じゅう";
      if (n < 20) return `じゅう${hiraNums[n - 10]}`;
      if (n === 20) return "にじゅう";
      if (n < 24) return `にじゅう${hiraNums[n - 20]}`;
      return String(n);
    };
    return `${h}じ`;
  }
  
  function clockHour(hour) {
    const h = hour % 12;
    return h === 0 ? 12 : h;
  }

  function hourLabel(value) {
    const t = parseTime(value);
    return t ? `${t.h}時` : "--時--";
  }

  function setHourPickerOpen(picker, isOpen) {
    const toggle = picker?.querySelector("[data-hour-picker-toggle]");
    const options = picker?.querySelector(".hour-picker-options");
    if (!toggle || !options) return;

    toggle.setAttribute("aria-expanded", String(isOpen));
    options.hidden = !isOpen;
    picker.classList.toggle("open", isOpen);
  }

  function closeHourPickers(exceptPicker = null) {
    document.querySelectorAll("[data-hour-picker]").forEach(picker => {
      if (picker !== exceptPicker) setHourPickerOpen(picker, false);
    });
  }

  function setHourPickerValue(input, value, emitChange = false) {
    if (!input) return;

    const picker = input.closest("[data-hour-picker]");
    const normalizedValue = value === undefined || value === null ? "" : String(value);
    input.value = normalizedValue;

    if (picker) {
      const toggle = picker.querySelector("[data-hour-picker-toggle]");
      const options = picker.querySelectorAll("[data-hour-value]");
      if (toggle) toggle.textContent = hourLabel(normalizedValue);

      options.forEach(option => {
        const isSelected = option.dataset.hourValue === normalizedValue;
        option.classList.toggle("selected", isSelected);
        option.setAttribute("aria-selected", String(isSelected));
      });
    }

    if (emitChange) input.dispatchEvent(new Event("change", { bubbles: true }));
  }

  function initializeHourPickers() {
    document.querySelectorAll("[data-hour-picker]").forEach(picker => {
      const input = picker.querySelector("input[type='hidden']");
      const toggle = picker.querySelector("[data-hour-picker-toggle]");

      toggle?.addEventListener("click", () => {
        const isOpen = toggle.getAttribute("aria-expanded") === "true";
        closeHourPickers(picker);
        setHourPickerOpen(picker, !isOpen);
      });

      picker.querySelectorAll("[data-hour-value]").forEach(option => {
        option.addEventListener("click", () => {
          setHourPickerValue(input, option.dataset.hourValue, true);
          setHourPickerOpen(picker, false);
        });
      });

      setHourPickerValue(input, input?.value || "");
    });

    document.addEventListener("click", event => {
      if (!event.target.closest("[data-hour-picker]")) closeHourPickers();
    });

    document.addEventListener("keydown", event => {
      if (event.key === "Escape") closeHourPickers();
    });
  }

function renderTimePreview(input, styleValue, preview) {
  if (!input || !preview) return;

  const t = parseTime(input.value);
  if (!t) {
    preview.textContent = "";
    delete preview.dataset.timeStyle;
    delete preview.dataset.timeValue;
    delete preview.dataset.timeText;
    return;
  }

  const style = normalizeTimeStyle(styleValue);
  const timeText = formatTime(t, style);
  preview.dataset.timeStyle = style;
  preview.dataset.timeValue = input.value;
  preview.dataset.timeText = timeText;

  if (style !== "clock") {
    preview.textContent = timeText;
    return;
  }

  preview.textContent = "";
  const img = document.createElement("img");
  img.src = clockImagePaths[clockHour(t.h)];
  img.className = "clock-image";
  img.alt = timeText;
  preview.appendChild(img);
}
  
  
    // ===== 編集ページの初期表示：preview(pタグ)の値を timeInput に反映する =====
    function pad2(n) {
    return String(n).padStart(2, "0");
  }

  function previewTextToTimeValue(text) {
    const t = parseTime(text);
    if (t) return String(t.h);

    const m = String(text || "").match(/\d+/);
    if (!m) return "";
    const h = Number(m[0]);
    if (!Number.isInteger(h) || h < 0 || h > 23) return "";
    return String(h);
  }

  for (let i = 1; i <= 7; i++) {
  const input = document.getElementById(`timeInput_${i}`);
  const preview = document.getElementById(`timePreview_${i}`);
  const saved = savedDayTimes[String(i)] || {};
  const savedText = saved.time || preview?.textContent || "";
  const savedTimeValue = previewTextToTimeValue(saved.timeValue || savedText);
  
  setHourPickerValue(input, savedTimeValue);

  const render = () => renderTimePreview(input, timeStyleInput?.value, preview);
  input?.addEventListener("change", render);

  render();
}

  timeStyleButtons.forEach(button => {
    button.addEventListener("click", () => {
      setTimeStyleValue(button.dataset.timeStyleValue);
      renderAllTimePreviews();
    });
  });
});

const savedDayTimes = <%= @calendar.to_json %>;
const clockImagePaths = {
  1: "/clock_images/one.gif",
  2: "/clock_images/two.gif",
  3: "/clock_images/three.gif",
  4: "/clock_images/four.gif",
  5: "/clock_images/five.gif",
  6: "/clock_images/six.gif",
  7: "/clock_images/seven.gif",
  8: "/clock_images/eight.gif",
  9: "/clock_images/nine.gif",
  10: "/clock_images/ten.gif",
  11: "/clock_images/eleven.gif",
  12: "/clock_images/twelve.gif"
  };
function normalizeTimeStyle(value) {
  const style = String(value || "").toLowerCase();
  if (style === "clock" || style === "image") return "clock";
  if (style === "hiragana") return "hiragana";
  return "kanji";
}

function inferTimeStyle(text) {
  return String(text || "").includes("じ") ? "hiragana" : "kanji";
}

</script>
</body>