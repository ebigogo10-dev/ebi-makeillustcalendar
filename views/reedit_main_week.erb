    <button class="save-button">
    保存
    </button>
    </div>
    <script src="/script.js"></script>
    <script>
      
      function buildCalendarJson() {
        const result = {};

        document.querySelectorAll('.day-column').forEach(column => {
          const dayKey = column.dataset.day;
          const zones = column.querySelectorAll('.drop-zone');

          result[dayKey] = Array.from(zones).map(zone => {
            const img = zone.querySelector('img');
            if (!img) return null;
            const url = new URL(img.src, window.location.origin);
            if (url.origin === window.location.origin) {
              return url.pathname;
            }
            return url.href;
          });
        });

        return result;
      }
      
      document.querySelector('.save-button').addEventListener('click', async () => {
      const data = buildCalendarJson();
    
      try {
        const res = await fetch("/recalendar_week/<%= @user.id %>/<%= @calendar_id.id %>", {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify(data)
        });
    
        if (!res.ok) {
          console.error('保存失敗', await res.text());
          alert('保存に失敗しました');
          return;
        }
    
        const json = await res.json();
        console.log('保存完了:', json);
        alert('保存できました！');
        if (json.redirect_to) {
        window.location.href = json.redirect_to;
        }
      } catch (e) {
        console.error('通信エラー', e);
        alert('通信エラーが発生しました');
      }
    });
    
    </script>
