<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>カレンダー型決め</title>
  <link href="/style.css" rel="stylesheet">
</head>

<body>
  <div class="sidebar">
    <a href="/show_day/<%= @user.id %>">カレンダー一覧</a>
    <button href="/edit_about_day/<%= @user.id %>">カレンダー作成</button>
    <a href="/setting/<%= @user.id %>">設定</a>
  </div>
  
  <div class="sidebar">
    <a href="/edit_about_day/<%= @user.id %>">dayカレンダーを作成</a>
    <button href="/edit_about_week/<%= @user.id %>">weekカレンダーを作成</button>
    <a href="/edit_about_month/<%= @user.id %>">monthカレンダーを作成</a>
  </div>
    
  <div class="about">
    <form action="/upload_image/<%= @user.id %>" method="post" enctype="multipart/form-data" class="action-form">
    	<input type="file" name="images[]" accept="image/*" multiple>
    	<button type="submit">画像をアップロード</button>
    </form>
    
    <form action="/newcreate_week/<%= @user.id%>" method="post" class="input">
      <a>カレンダー名</a>
      <input type="text" name="calendar_name" value="<%= Date.today.beginning_of_week %>の週のカレンダー">
      <a>はじめの日付</a>
      <input type="date" name="selected_date" value="<%= Date.today.beginning_of_week %>">
      <a>曜日の色</a>
      <select name="color">
      <option value="nothing">指定なし</option>
      <option value="3colors">平日→白 土曜→青 日曜→赤</option>
      <option value="7colors">７色</option>
      </select>
      <a>曜日の表記</a>
      <select name="display">
      <option value="Kanji">漢字(月)</option>
      <option value="Hiragana">ひらがな(げつ)</option>
      </select>
      <button type="submit">カレンダーを作る</button>
    </form>
    
  </div>
</body>