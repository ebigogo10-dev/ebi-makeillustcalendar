<body>
  <div class="sidebar">
    <button href="/show_day/<%= @user.id %>">カレンダー一覧</button>
    <a href="/edit_about_day/<%= @user.id %>">カレンダー作成</a>
    <a href="/setting/<%= @user.id %>">設定</a>
  </div>
  
  <div class="sidebar">
    <button href="/show_day/<%= @user.id %>">dayカレンダーを見る</button>
    <a href="/show_week/<%= @user.id %>">weekカレンダーを見る</a>
    <a href="/show_month/<%= @user.id %>">monthカレンダーを見る</a>
  </div>
  
  <div class="show">
    <div class="day">
      <div class="calendar-list">
      <% @calendar_day.each do |calendar| %>
        <% calendar_name = calendar.calendar_name.to_s.strip %>
        <% calendar_name = "無題のカレンダー" if calendar_name.empty? %>
        <% escaped_calendar_name = Rack::Utils.escape_html(calendar_name) %>
        <div class="card-size">
          <div class="calendar-card">
            <div class="calendar-name-editor" data-update-url="/calendar_name/<%= @user.id %>/<%= calendar.id %>" data-current-name="<%= escaped_calendar_name %>">
              <h3 class="calendar-name-text"><%= escaped_calendar_name %></h3>
              <input type="text" class="calendar-name-input" value="<%= escaped_calendar_name %>" aria-label="カレンダー名" maxlength="255" hidden>
              <button type="button" class="calendar-name-edit-btn" aria-label="カレンダー名を編集" title="カレンダー名を編集">
                <img src="/pen.png" alt="" aria-hidden="true">
              </button>
            </div>
            <% if calendar.start_day.nil? && calendar.day.nil? %>
            <p>カレンダーの日付:不明 / 作成日:不明</p>
              <% if @user.name.nil? %>
              <p>作成者:<%= @user.mail%></p>
              <% else %>
              <p>作成者:<%= @user.name%></p>
              <% end %>
            <% elsif calendar.start_day.nil?%>
            <p>カレンダーの日付:不明 / 作成日:<%= calendar.day %></p>
              <% if @user.name.nil? %>
              <p>作成者:<%= @user.mail%></p>
              <% else %>
              <p>作成者:<%= @user.name%></p>
              <% end %>
            <% elsif calendar.day.nil?%>
            <p>カレンダーの日付:<%= calendar.start_day.strftime("%Y年%m月")%> / 作成日:不明</p>
              <% if @user.name.nil? %>
              <p>作成者:<%= @user.mail%></p>
              <% else %>
              <p>作成者:<%= @user.name%></p>
              <% end %>
            <% else %>
              <p>カレンダーの日付:<%= calendar.start_day.strftime("%Y年%m月")%> / 作成日:<%= calendar.day %></p>
              <% if @user.name.nil? %>
              <p>作成者:<%= @user.mail%></p>
              <% else %>
              <p>作成者:<%= @user.name%></p>
              <% end %>
            <% end %>
          
            <% if calendar.color == "7colors"
            color1 = "#ffe5fb"   # さらに薄く
            color2 = "#eaddff"      # さらに薄く
            color3 = "#dff9ff"
            color4 = "#efffdf"
            color5 = "#fffadf"
            color6 = "#ffeadf"
            color7 = "#ffdfdf"
