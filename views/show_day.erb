  <script>
  document.querySelectorAll(".pdf-btn").forEach(btn => {
  btn.addEventListener("click", async () => {
    const calendarCard = btn.closest(".calendar-card");
    const dayCalendar = calendarCard.querySelector(".day-calendar");

    if (!dayCalendar) {
      alert("PDF化するdayカレンダーが見つかりませんでした。");
      return;
    }

    const filename = ((btn.dataset.calendarName || "カレンダー")
      .replace(/[\\/:*?"<>|]/g, "_")
      .trim() || "カレンダー") + ".pdf";

    const timeColumns = dayCalendar.querySelectorAll(".time-column");
    const colors = Array.from(timeColumns).map(col => {
      return col.style.background || col.style.backgroundColor || "";
    });

    const pdfStage = document.createElement("div");
    pdfStage.style.position = "fixed";
    pdfStage.style.left = "0";
    pdfStage.style.top = "0";
    pdfStage.style.width = "100vw";
    pdfStage.style.height = "100vh";
    pdfStage.style.background = "rgba(255,255,255,0.01)";
    pdfStage.style.zIndex = "999999";
    pdfStage.style.overflow = "visible";
    pdfStage.style.pointerEvents = "none";

    const pdfPage = document.createElement("div");

    // A4縦をpxで固定
    pdfPage.style.width = "794px";
    pdfPage.style.height = "1123px";
    pdfPage.style.background = "white";
    pdfPage.style.padding = "16px";
    pdfPage.style.boxSizing = "border-box";
    pdfPage.style.overflow = "hidden";

    pdfPage.innerHTML = `
      <style>
        .pdf-day-calendar {
          width: 100%;
          height: 100%;
          display: grid;
          grid-template-rows: 70px repeat(7, minmax(0, 1fr));
          background: white;
          box-sizing: border-box;
          overflow: hidden;
        }

        .pdf-day-calendar .date-column {
          display: flex;
          align-items: center;
          justify-content: center;
          border-top: 1px solid black;
          border-bottom: 1px solid black;
          box-sizing: border-box;
          overflow: hidden;
          padding: 4px;
          min-height: 0;
        }

        .pdf-day-calendar .date-column p {
          margin: 0;
          font-size: 30px;
          font-weight: bold;
          line-height: 1;
          text-align: center;
        }

        .pdf-day-calendar .time-column {
          display: grid;
          grid-template-columns: 95px 1fr;
          min-height: 0;
          overflow: hidden;
          border-bottom: 1px solid black;
          box-sizing: border-box;
          padding: 6px 6px 6px 0;
        }

        .pdf-day-calendar .time-column:nth-of-type(2) { background-color: ${colors[0]} !important; }
        .pdf-day-calendar .time-column:nth-of-type(3) { background-color: ${colors[1]} !important; }
        .pdf-day-calendar .time-column:nth-of-type(4) { background-color: ${colors[2]} !important; }
        .pdf-day-calendar .time-column:nth-of-type(5) { background-color: ${colors[3]} !important; }
        .pdf-day-calendar .time-column:nth-of-type(6) { background-color: ${colors[4]} !important; }
        .pdf-day-calendar .time-column:nth-of-type(7) { background-color: ${colors[5]} !important; }
        .pdf-day-calendar .time-column:nth-of-type(8) { background-color: ${colors[6]} !important; }

        .pdf-day-calendar .time-display {
          width: auto;
          height: 100%;
          min-height: 0;
          display: flex;
          align-items: center;
          justify-content: center;
          border-right: 1px solid black;
          box-sizing: border-box;
          padding: 4px;
          overflow: hidden;
          text-align: center;
        }

        .pdf-day-calendar .time-display p {
          margin: 0;
          font-size: 20px;
          font-weight: bold;
          line-height: 1.1;
          word-break: break-word;
        }

        .pdf-day-calendar .drop-zones {
          height: 100%;
          min-height: 0;
          display: grid;
          grid-template-columns: repeat(5, minmax(0, 1fr));
          gap: 6px;
          padding-left: 6px;
          box-sizing: border-box;
          overflow: hidden;
        }

        .pdf-day-calendar .drop-zone {
          min-width: 0;
          min-height: 0;
          border: 1px dashed #ddd;
          display: flex;
          align-items: center;
          justify-content: center;
          box-sizing: border-box;
          overflow: hidden;
        }

        .pdf-day-calendar .day-image,
        .pdf-day-calendar .clock-image {
          max-width: 78%;
          max-height: 78%;
          object-fit: contain;
          display: block;
        }
      </style>

      <div class="pdf-day-calendar">
        ${dayCalendar.innerHTML}
      </div>
    `;

    pdfStage.appendChild(pdfPage);
    document.body.appendChild(pdfStage);

    const images = pdfPage.querySelectorAll("img");

    const imagePromises = Array.from(images).map(img => {
      return new Promise(resolve => {
        if (img.complete) {
          resolve();
        } else {
          img.onload = resolve;
          img.onerror = resolve;
        }
      });
    });

    await Promise.all(imagePromises);
    await new Promise(resolve => setTimeout(resolve, 500));

    // ここからが重要：html2pdfではなく、1枚画像としてA4に貼る
    try {
      if (typeof html2canvas === "undefined") {
        throw new Error("html2canvas が読み込まれていません。");
      }
    
      if (!window.jspdf || !window.jspdf.jsPDF) {
        throw new Error("jsPDF が読み込まれていません。");
      }
    
      const canvas = await html2canvas(pdfPage, {
        scale: 2,
        useCORS: true,
        backgroundColor: "#ffffff",
        scrollX: 0,
        scrollY: 0,
        width: 794,
        height: 1123,
        windowWidth: 794,
        windowHeight: 1123
      });
    
      const imageData = canvas.toDataURL("image/jpeg", 0.98);
    
      const { jsPDF } = window.jspdf;
    
      const pdf = new jsPDF({
        orientation: "portrait",
        unit: "mm",
        format: "a4"
      });
    
      pdf.addImage(imageData, "JPEG", 0, 0, 210, 297);
      pdf.save(filename);
    } catch (error) {
      console.error(error);
      alert("PDF保存に失敗しました。consoleを確認してください。");
    } finally {
      if (document.body.contains(pdfStage)) {
        document.body.removeChild(pdfStage);
      }
    }
  });
});

