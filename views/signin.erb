<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ログイン</title>
  <link href="style.css" rel="stylesheet" />
</head>
<body>
  
  <div class="main">
    
  <form action="/signin" method="post">
    <input type="text" class="form-control" placeholder="メールアドレス" name="mail" required>
    <input type="password" class="form-control" placeholder="パスワード" name="password" required>
    <button type="submit" class="btn btn-success">ログイン</button>
  </form>
  
  <a href="/signup" class="btn btn-success btn-center">アカウントをお持ちでない方はこちら</a>
  
  </div>
  
</body>